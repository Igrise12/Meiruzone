# Allow only application sources, locked dependencies, and container configuration.
**
!pyproject.toml
!uv.lock
!app/
app/**
!app/*.py
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!docker/
docker/**
!docker/*.Dockerfile
!docker/nginx.conf
# Re-included source trees must still exclude local credentials and caches.
**/.env*
**/__pycache__
**/*.pyc
**/node_modules
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.eml
**/*.mbox
**/*.joblib
**/*.pkl
**/*.pickle
**/*.onnx
**/*.safetensors
