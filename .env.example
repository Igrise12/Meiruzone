# Safe template: copy to ignored .env for local backend configuration.
# Relative paths are resolved from the process working directory.
MEIRUZONE_DATABASE_PATH=data/meiruzone.sqlite3
MEIRUZONE_DEMO=false
MEIRUZONE_REVIEW_THRESHOLD=70
MEIRUZONE_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional real IMAP: one account and one folder, using verified TLS only.
# Startup never contacts the mailbox; POST /api/v1/sync explicitly starts retrieval.
# Supply actual secrets only in the process environment or your private .env.
# Passwords never enter the frontend, API responses, logs, or application database.
# Use your provider's app password if required. Keep .env readable only by your user.
# MEIRUZONE_IMAP_HOST=imap.example.test
MEIRUZONE_IMAP_PORT=993
# MEIRUZONE_IMAP_USERNAME=your-address@example.test
# MEIRUZONE_IMAP_PASSWORD=
MEIRUZONE_IMAP_MAILBOX=INBOX
