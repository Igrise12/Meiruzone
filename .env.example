# Safe template: copy to ignored .env for local backend configuration.
# Relative paths are resolved from the process working directory.
MEIRUZONE_DATABASE_PATH=data/meiruzone.sqlite3
MEIRUZONE_DEMO=false
# Select an exact locally trained run only after reviewing its evaluation.
# Restart the backend after changing this path. Joblib files must be trusted.
# MEIRUZONE_MODEL_DIRECTORY=models/category-<UTC timestamp>-<unique suffix>
# Leave unset to use each prediction's saved validation cutoff (null = review all).
# Set explicitly only to override all saved cutoffs, including review-all.
# MEIRUZONE_REVIEW_THRESHOLD=70
MEIRUZONE_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Compose only: match your host user/group (id -u / id -g).
# Mount directories must already exist and be owned by that user.
MEIRUZONE_UID=1000
MEIRUZONE_GID=1000
MEIRUZONE_DATA_DIRECTORY=./data
MEIRUZONE_MODELS_DIRECTORY=./models
# Loopback host ports. Rebuild the frontend after changing the API port.
# When changing the frontend port, also update MEIRUZONE_FRONTEND_ORIGINS above.
# MEIRUZONE_API_PORT=8001
# MEIRUZONE_FRONTEND_PORT=5173
# Compose reads this backend-only file; an absent default .env is allowed.
# MEIRUZONE_ENV_FILE=.env

# Optional real IMAP: one account and one folder, using verified TLS only.
# Startup never contacts the mailbox; POST /api/v1/sync explicitly starts retrieval.
# Supply actual secrets only in the process environment or your private .env.
# Passwords never enter the frontend, API responses, logs, or application database.
# Use your provider's app password if required. Keep .env readable only by your user.
# MEIRUZONE_IMAP_HOST=imap.example.test
MEIRUZONE_IMAP_PORT=993
# MEIRUZONE_IMAP_USERNAME=your-address@example.test
# MEIRUZONE_IMAP_PASSWORD=
MEIRUZONE_IMAP_MAILBOX=INBOX
